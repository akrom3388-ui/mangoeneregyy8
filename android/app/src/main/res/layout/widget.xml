<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/mm_mango" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:text="Mango Monitor"/>
    <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E8EEF6" android:textSize="13sp" android:maxLines="3" android:text="—"/>
</LinearLayout>
